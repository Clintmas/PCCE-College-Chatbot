-- 1. General college information

INSERT OR REPLACE INTO college_details
(topic, information)
VALUES
(
    'about_college',
    'Padre Conceicao College of Engineering (PCCE) is an engineering college located in Verna, Goa. It was established in 1997.'
),
(
    'affiliation',
    'PCCE is affiliated to Goa University and its programmes are approved by AICTE. The college is managed by Agnel Charities.'
),
(
    'admission_process',
    'For undergraduate engineering admissions, students should follow the admission process and updates published by the Directorate of Technical Education Goa. Visit https://dte.goa.gov.in/'
),
(
    'admission_eligibility',
    'For first-year BE admission, applicants need HSSC or equivalent with Physics and Mathematics and one eligible third subject. The minimum aggregate is 45 percent for general category and 40 percent for SC, ST and OBC candidates. A valid JEE Main score for the admission year is required. Check the official admission page for complete conditions.'
),
(
    'library',
    'PCCE Central Library has more than 25,728 books, including textbooks and reference books. It also subscribes to more than 187 IEEE e-journals, 1,400 proceedings and 44 print journals and magazines.'
),
(
    'digital_library',
    'PCCE Central Library provides access to DELNET, National Digital Library of India (NDLI), IEEE resources and e-books through Videeya.'
),
(
    'placements',
    'PCCE has a dedicated Training and Placement Cell that supports on-campus and off-campus recruitment, internships, projects, career guidance and placement preparation.'
),
(
    'placement_activities',
    'The Training and Placement Cell organizes recruitment drives, training programmes, workshops, guest lectures, hackathons, field trips and panel discussions.'
);


-- 2. Add Information Technology to the courses table

INSERT OR IGNORE INTO courses
(course_name, level)
VALUES
('Information Technology', 'Bachelor''s');



INSERT OR REPLACE INTO college_details
(topic, information)
VALUES
(
    'fees',
    'The college fees are approximately ₹80,000 to ₹1,00,000. The exact amount may vary. Please contact the college for the applicable fee structure.'
),
(
    'hostel',
    'Padre Conceicao College of Engineering does not provide hostel facilities.'
),
(
    'transport',
    'Padre Conceicao College of Engineering does not provide private bus transport facilities.'
);



UPDATE college_details
SET information = 'The college fees are approximately ₹80,000 to ₹1,00,000 per semester. The exact amount may vary. Please contact the college for the latest fee structure.'
WHERE topic = 'fees';

</sql><current_tab id="0"/></tab_sql></sqlb_project>
